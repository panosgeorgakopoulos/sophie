# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# vite-built widget bundle -- regenerated by `npx vite build` / `npm run build`,
# committing the compiled output would just create unreviewable diffs.
/public/widget.js

# A full saved snapshot of a live ifg.gr page (used for local widget preview),
# which embeds ifg.gr's own third-party API keys (e.g. Google Maps) verbatim
# from their public page source -- not something to redistribute in git
# history. Local-only; the /preview route provides a live equivalent.
/public/demo.html

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data
/datasets/
docx_dump.txt
