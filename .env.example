# Separate DB accounts. Application/public reader must not own DDL.
DATABASE_URL=postgres://sophie_app:REPLACE@localhost:5432/sophie
PUBLIC_DATABASE_URL=postgres://sophie_reader:REPLACE@localhost:5432/sophie
# Set only in migration/administrative jobs, not the public runtime.
MIGRATION_DATABASE_URL=
DB_POOL_MAX=5
APP_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=https://www.ifg.gr,https://ifg.gr
# A single-IP header OVERWRITTEN by the trusted proxy. Block direct origin access.
# Unset => every visitor shares a conservative unknown-client quota.
TRUSTED_CLIENT_IP_HEADER=
RATE_LIMIT_STORE=postgres
RAG_MIN_SIMILARITY=0.55

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# Enable only after approval of provider, data flow and audience. These flags
# are operational gates, not proof of legal or contractual compliance.
GEMINI_PROCESSING_APPROVED=false
GEMINI_APPROVED_FOR_PUBLIC_USE=false
GEMINI_PAID_SERVICE_CONFIRMED=false
GEMINI_REQUESTS_PER_MINUTE=60
GEMINI_REQUESTS_PER_DAY=2000
GEMINI_PUBLIC_REQUESTS_PER_MINUTE=20
GEMINI_PUBLIC_REQUESTS_PER_DAY=500

# Shared private volume OUTSIDE the application root; API writes, worker reads.
UPLOAD_DIR=
# Absolute clamscan path in worker. Missing scanner => quarantine.
CLAMSCAN_PATH=
# Production binary parsers require a separately built image, pinned by digest.
PARSER_CONTAINER_IMAGE=
CONTAINER_RUNTIME_PATH=/usr/bin/docker

# Retired public email endpoints never send. Helper requires explicit SMTP config.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Manual smoke/scenario tools. Never point automated CI at production.
TEST_API_URL=http://localhost:3000/api/chat
TEST_DATABASE_URL=
