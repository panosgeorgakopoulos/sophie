# Postgres connection string. Must point at a database with the pgvector
# extension available (schema.sql runs `create extension if not exists vector`).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Gemini API key (free tier is sufficient for the MVP). Get one at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Comma-separated list of origins allowed to call /api/chat and /api/feedback
# cross-origin (the real ifg.gr domain(s) the widget is embedded on).
# localhost:3000 is always allowed for local dev regardless of this setting.
ALLOWED_ORIGINS=https://www.ifg.gr,https://ifg.gr

# Minimum cosine similarity (0-1) for a retrieved chunk to be used as context.
# Empirically calibrated -- see src/lib/retrieval.ts for the reasoning.
# Optional; defaults to 0.55.
RAG_MIN_SIMILARITY=0.55

# How many days back to consider a /news/ post "current" during ingestion.
# Older news posts are skipped so stale announcements aren't treated as
# current fact. Optional; defaults to 365.
NEWS_MAX_AGE_DAYS=365

# Optional SMTP credentials for src/lib/email.ts (used by the Google Form
# webhook and Outlook add-in, both out of scope for the hardening in this
# repo's current state). Falls back to a mocked/console-logged send if unset.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Only used by src/scripts/smoke_test.ts and src/scripts/test_scenarios.ts to
# point at a running dev server. Optional; defaults to http://localhost:3000/api/chat.
TEST_API_URL=http://localhost:3000/api/chat

# Signs the staff admin dashboard's session cookie (src/lib/adminAuth.ts).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=
